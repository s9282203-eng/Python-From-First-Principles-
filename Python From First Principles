# 2. OPERATORS
# =========================================================

a = 10
b = 5

print("\n=== OPERATORS ===")

print("Addition:", a + b)
print("Subtraction:", a - b)
print("Multiplication:", a * b)
print("Division:", a / b)

print("Greater Than:", a > b)
print("Equal:", a == b)

print(True and False)
print(True or False)


# =========================================================
# 3. CONDITIONS
# =========================================================

print("\n=== CONDITIONS ===")

temperature = 35

if temperature > 30:
    print("Hot Weather")
else:
    print("Cool Weather")


# =========================================================
# 4. LOOPS
# =========================================================

print("\n=== FOR LOOP ===")

for i in range(5):
    print(i)

print("\n=== WHILE LOOP ===")

x = 0

while x < 5:
    print(x)
    x += 1


