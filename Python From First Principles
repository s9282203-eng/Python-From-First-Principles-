# =========================================================
# 9. OBJECT ORIENTED PROGRAMMING (OOP)
# =========================================================

print("\n=== OOP ===")

class Car:

    def __init__(self, brand):
        self.brand = brand

    def start(self):
        print(self.brand, "Engine Started")


mycar = Car("Toyota")

mycar.start()


