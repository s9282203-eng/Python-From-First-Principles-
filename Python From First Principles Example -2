name = "subham"
age = 28
marks = 85

def calculate_grade(score):

    if score >= 90:
        return "A"

    elif score >= 80:
        return "B"

    elif score >= 70:
        return "C"

    else:
        return "D"

grade = calculate_grade(marks)

print("Student Name:", name)
print("Age:", age)
print("Marks:", marks)
print("Grade:", grade)

print("\nProgress:")

for i in range(5):
    print("Step", i)
